# Resend (https://resend.com) — contact form email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender must be on a domain verified in Resend (e.g. rptennisdubai.com)
CONTACT_FROM="RP Tennis Website <website@rptennisdubai.com>"
# Where enquiries are delivered (comma-separated for several)
CONTACT_TO=rallypointtennisacademy@gmail.com

# Canonical site URL used for metadata, sitemap and robots
NEXT_PUBLIC_SITE_URL=https://rptennisdubai.com

# Optional: Google Analytics 4 measurement ID (enables Robin Hood referral events)
NEXT_PUBLIC_GA_ID=
